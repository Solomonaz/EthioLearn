generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  STUDENT
}

enum SchoolType {
  PUBLIC
  PRIVATE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ChunkingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_IN_BLANK
  MATCH_PAIRS
  ORDERING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizMode {
  SOLO
  TIMED
  GROUP
}

enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum RewardTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  DENIED
  FULFILLED
}

enum RedemptionWindow {
  ANYTIME
  MONTHLY
  QUARTERLY
  SEMESTER
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlanAudience {
  SCHOOL
  STUDENT
}

enum PricingModel {
  FLAT // fixed price (student plans)
  PER_STUDENT // school plans: price = rate × enrolled students
  TIERED // school plans: price from the bracket matching student count
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMESTER
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  phoneNumber   String?   @unique
  email         String?   @unique
  name          String
  role          UserRole  @default(STUDENT)
  grade         Int?
  section       String?
  avatarUrl     String?
  xpLevel       Int       @default(1)
  totalPoints   Int       @default(0)
  streakDays    Int       @default(0)
  isActive      Boolean   @default(true)
  suspendedAt   DateTime?
  suspendReason String?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Social login identifiers
  googleId   String? @unique
  facebookId String? @unique
  telegramId String? @unique

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  // Relations
  quizzes              Quiz[]
  hostedGameRooms      GameRoom[]        @relation("GameHost")
  gameParticipations   GamePlayer[]
  redemptions          Redemption[]
  pointLedger          PointLedger[]
  uploadedTextbooks    Textbook[]        @relation("TextbookUploader")
  approvedRedemptions  Redemption[]      @relation("RedemptionApprover")
  notifications        Notification[]
  achievements         UserAchievement[]
  studentBooks         StudentBook[]
  createdTournaments   Tournament[]      @relation("TournamentCreator")
  sessions             UserSession[]
  subscriptions        Subscription[]    @relation("StudentSubscriptions")
  createdSubscriptions Subscription[]    @relation("SubscriptionCreator")

  @@map("users")
}

// ─── Subjects ───────────────────────────────────────────────

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

// ─── OTP Codes ────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(cuid())
  key       String   @unique // phone number
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

// ─── User Sessions ────────────────────────────────────────

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  sessionId  String    @unique @default(cuid())
  deviceName String?
  userAgent  String?   @db.Text
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("user_sessions")
}

model School {
  id               String     @id @default(cuid())
  name             String
  region           String
  city             String
  type             SchoolType @default(PUBLIC)
  subscriptionTier String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users         User[]
  textbooks     Textbook[]
  rewards       Reward[]
  rewardBudgets RewardBudget[]
  tournaments   Tournament[]
  gameConfig    GameConfig?
  subscriptions Subscription[]

  @@map("schools")
}

model Textbook {
  id               String           @id @default(cuid())
  title            String
  grade            Int
  subject          String
  language         String           @default("en")
  academicYear     String?
  edition          String?
  publisher        String?
  content          String?          @db.Text
  fileUrl          String
  processingStatus ProcessingStatus @default(PENDING)
  chunkingStatus   ChunkingStatus   @default(PENDING)
  ocrFlaggedPages  Json? // array of { page, confidence } for pages below 80% OCR confidence
  chapterCount     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  uploadedById String?
  uploadedBy   User?   @relation("TextbookUploader", fields: [uploadedById], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  chapters Chapter[]

  @@map("textbooks")
}

model Chapter {
  id            String   @id @default(cuid())
  chapterNumber Int
  title         String
  content       String?  @db.Text
  contentHash   String?
  topicTags     String[] @default([])
  bloomLevels   String[] @default([])
  questionCount Int      @default(0)
  ocrConfidence Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  questions Question[]
  chunks    ContentChunk[]

  @@unique([textbookId, chapterNumber])
  @@map("chapters")
}

model Question {
  id            String         @id @default(cuid())
  type          QuestionType   @default(MCQ)
  difficulty    Difficulty     @default(MEDIUM)
  status        QuestionStatus @default(PUBLISHED)
  questionText  String
  options       Json           @default("[]")
  correctAnswer String
  explanation   String?
  videoUrl      String?
  bloomLevel    String?
  qualityScore  Float?
  qualityFlags  String[]       @default([])
  usageCount    Int            @default(0)
  avgAccuracy   Float?
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  quizAnswers QuizAnswer[]

  @@map("questions")
}

model Quiz {
  id                String    @id @default(cuid())
  mode              QuizMode  @default(SOLO)
  score             Int       @default(0)
  totalPointsEarned Int       @default(0)
  totalQuestions    Int       @default(0)
  correctAnswers    Int       @default(0)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  isDailyChallenge Boolean @default(false)

  gameRoomId String?
  gameRoom   GameRoom? @relation(fields: [gameRoomId], references: [id])

  answers QuizAnswer[]

  @@map("quizzes")
}

model QuizAnswer {
  id            String  @id @default(cuid())
  studentAnswer String
  isCorrect     Boolean
  timeTakenMs   Int
  pointsEarned  Int     @default(0)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_answers")
}

model GameRoom {
  id         String     @id @default(cuid())
  roomCode   String     @unique
  status     GameStatus @default(WAITING)
  quizConfig Json       @default("{}")
  maxPlayers Int        @default(20)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hostUserId String
  host       User   @relation("GameHost", fields: [hostUserId], references: [id])

  players         GamePlayer[]
  quizzes         Quiz[]
  tournamentRound TournamentRound?

  @@map("game_rooms")
}

model GamePlayer {
  id       String   @id @default(cuid())
  score    Int      @default(0)
  rank     Int?
  joinedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameRoomId String
  gameRoom   GameRoom @relation(fields: [gameRoomId], references: [id], onDelete: Cascade)

  @@unique([userId, gameRoomId])
  @@map("game_players")
}

model Reward {
  id                      String           @id @default(cuid())
  tier                    RewardTier
  name                    String
  description             String?
  pointsCost              Int
  inventoryCount          Int              @default(0)
  imageUrl                String?
  unitCost                Float?
  redemptionWindow        RedemptionWindow @default(ANYTIME)
  windowStartDate         DateTime?
  windowEndDate           DateTime?
  maxRedemptionsPerWindow Int?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id        String           @id @default(cuid())
  status    RedemptionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("RedemptionApprover", fields: [approvedById], references: [id])

  @@map("redemptions")
}

model PointLedger {
  id          String   @id @default(cuid())
  actionType  String
  points      Int
  description String?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  quizId String?

  @@map("point_ledger")
}

model Notification {
  id        String   @id @default(cuid())
  type      String // "achievement", "reward", "battle_invite", "streak", "level_up", "system"
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json? // optional metadata (e.g., achievementId, rewardId)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  code     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("user_achievements")
}

model StudentBook {
  id               String           @id @default(cuid())
  title            String
  description      String?
  fileUrl          String
  content          String?          @db.Text // extracted text from the uploaded file
  processingStatus ProcessingStatus @default(PENDING)
  isPublic         Boolean          @default(false)
  storageBytes     Int              @default(0)
  quizCount        Int              @default(0)
  pointsAwarded    Boolean          @default(false) // true once +300 pts credited
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  @@map("student_books")
}

// ─── Reward Budget ──────────────────────────────────────

model RewardBudget {
  id          String   @id @default(cuid())
  name        String
  totalBudget Float
  spentAmount Float    @default(0)
  currency    String   @default("ETB")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@map("reward_budgets")
}

// ─── Tournaments & Game Config ──────────────────────────

model Tournament {
  id               String           @id @default(cuid())
  name             String
  description      String?
  status           TournamentStatus @default(DRAFT)
  rules            Json?
  competitionStart DateTime?
  competitionEnd   DateTime?
  maxPlayers       Int              @default(100)
  subject          String?
  grade            Int?
  difficulty       Difficulty?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdById String
  createdBy   User   @relation("TournamentCreator", fields: [createdById], references: [id])

  rounds TournamentRound[]

  @@map("tournaments")
}

model TournamentRound {
  id          String    @id @default(cuid())
  roundNumber Int
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime  @default(now())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  gameRoomId String?   @unique
  gameRoom   GameRoom? @relation(fields: [gameRoomId], references: [id])

  @@unique([tournamentId, roundNumber])
  @@map("tournament_rounds")
}

model GameConfig {
  id                String     @id @default(cuid())
  maxPlayersPerRoom Int        @default(20)
  timePerQuestion   Int        @default(20)
  defaultDifficulty Difficulty @default(MEDIUM)
  difficultyLocked  Boolean    @default(false)
  minPlayersToStart Int        @default(2)
  updatedAt         DateTime   @updatedAt

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id])

  @@map("game_configs")
}

// ─── Content Chunks (pgvector semantic retrieval) ───────

model ContentChunk {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String                      @db.Text
  tokenCount Int
  bloomLevel String?
  embedding  Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@unique([chapterId, chunkIndex])
  @@index([chapterId])
  @@map("content_chunks")
}

// ─── Pricing & Subscriptions ────────────────────────────

model PricingPlan {
  id              String          @id @default(cuid())
  name            String
  description     String?
  audience        PlanAudience
  pricingModel    PricingModel    @default(FLAT)
  // FLAT → the price; PER_STUDENT → rate per enrolled student; TIERED → null (see tiers)
  price           Float?
  currency        String          @default("ETB")
  billingInterval BillingInterval @default(MONTHLY)
  trialDays       Int             @default(0)
  features        String[]        @default([])
  isActive        Boolean         @default(true) // available for assignment
  sortOrder       Int             @default(0)

  // Entitlements — what the plan unlocks. Primarily for STUDENT plans; school
  // students and school plans are always treated as full access regardless.
  // Default true so existing/full plans keep every capability.
  allowAi          Boolean @default(true) // AI tutor, AI video, AI quiz generation
  allowMultiplayer Boolean @default(true) // battle / group games (solo is always allowed)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tiers         PricingTier[]
  subscriptions Subscription[]

  @@index([audience])
  @@map("pricing_plans")
}

model PricingTier {
  id          String   @id @default(cuid())
  minStudents Int
  maxStudents Int? // null = no upper bound
  price       Float
  createdAt   DateTime @default(now())

  planId String
  plan   PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("pricing_tiers")
}

model Subscription {
  id     String      @id @default(cuid())
  planId String
  plan   PricingPlan @relation(fields: [planId], references: [id])

  // Exactly one of schoolId / studentId is set, matching the plan's audience.
  schoolId  String?
  school    School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String?
  student   User?   @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)

  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?

  // Snapshot of the computed price at assignment time (audit trail).
  amount               Float?
  currency             String  @default("ETB")
  studentCountSnapshot Int? // school subs: enrolled students when priced
  notes                String?

  createdById String?
  createdBy   User?   @relation("SubscriptionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([planId])
  @@map("subscriptions")
}
