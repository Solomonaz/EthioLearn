generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  // Primary/middle-cycle teacher (grades 1-8). Owns the classroom games surface
  // at /teacher. Kept under the original name so no existing row migrates.
  TEACHER
  // Secondary-cycle teacher (grades 9-12). Owns the cohort-insights surface at
  // /secondary-teacher. Deliberately a separate role, not a band derived from
  // TeachingAssignment, so the grades 1-8 surface excludes them by role check
  // alone and needs no band logic added inside it.
  SECONDARY_TEACHER
  STUDENT
}

enum SchoolType {
  PUBLIC
  PRIVATE
}

/// Elementary (grades 1-8) and secondary (grades 9-12) schools are separate
/// institutions. The level decides which teacher role the school admin creates
/// (TEACHER vs SECONDARY_TEACHER) and whether the school may enrol students —
/// elementary schools have none. Fixed at creation.
enum SchoolLevel {
  ELEMENTARY
  SECONDARY
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ChunkingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// A school's textbook upload waits for super-admin approval before any paid
/// AI work (chapter detection, embeddings, question generation) touches it.
/// Library and super-admin books are created APPROVED.
enum TextbookApproval {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_IN_BLANK
  MATCH_PAIRS
  ORDERING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// What a teacher set. Purely a label: it changes wording and filtering, not
// how the activity behaves. Kept open-ended so "other activities" fit.
enum ActivityKind {
  HOMEWORK
  CLASSWORK
  ASSIGNMENT
  TEST
  PRACTICE
}

enum ActivityStatus {
  /// Generated but NOT yet given to anyone. A teacher must read it first:
  /// AI writes plausible-looking wrong answers, and the moment work reaches a
  /// class it cannot be unseen. Students never load a DRAFT.
  DRAFT
  PUBLISHED
  CLOSED
}

// How an activity is carried out.
//   QUESTIONS — a pinned set of questions the student sits and is auto-marked.
//   DOCUMENT  — written work the student reads and does, often on paper. There
//               is nothing to auto-mark, so completion is the student saying so.
enum ActivityFormat {
  QUESTIONS
  DOCUMENT
}

enum QuizMode {
  SOLO
  TIMED
  GROUP
}

enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
}

// Elementary (grades 1–6) game content. One row feeds several game skins:
//   PAIR     → memory game, find-the-pair, tug-of-war prompts
//   CATEGORY → grouping (drag items into their category)
//   MCQ      → tug-of-war question rounds
enum GameContentType {
  PAIR
  CATEGORY
  MCQ
}

enum RewardTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  DENIED
  FULFILLED
}

enum RedemptionWindow {
  ANYTIME
  MONTHLY
  QUARTERLY
  SEMESTER
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlanAudience {
  SCHOOL
  STUDENT
}

enum PricingModel {
  FLAT // fixed price (student plans)
  PER_STUDENT // school plans: price = rate × enrolled students
  TIERED // school plans: price from the bracket matching student count
  PER_TEACHER // school plans: price = rate × active teachers (elementary schools have no students)
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMESTER
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

// Manual (off-platform) payment proof submitted by a student, reviewed by an admin.
enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  phoneNumber      String?   @unique
  email            String?   @unique
  name             String
  role             UserRole  @default(STUDENT)
  grade            Int?
  section          String?
  avatarUrl        String?
  xpLevel          Int       @default(1)
  totalPoints      Int       @default(0)
  // Points that may be spent on rewards. Only earned from quizzes scored at or
  // above the quality threshold — protects the prize economy from point farming.
  redeemablePoints Int       @default(0)
  streakDays       Int       @default(0)
  isActive         Boolean   @default(true)
  suspendedAt      DateTime?
  suspendReason    String?
  lastActiveAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Social login identifiers
  googleId   String? @unique
  facebookId String? @unique
  telegramId String? @unique

  // ── Password sign-in (lib/password.ts) ──
  /// School-issued sign-in name for students a school creates (they may have
  /// no email). Lower-case; everyone else signs in with their email.
  username           String?   @unique
  /// scrypt hash, "scrypt$<salt>$<hash>". Null = no password yet (Google or
  /// Telegram only, or an admin-created account whose owner has not set one).
  passwordHash       String?
  /// Set on a school-issued temporary password: the user must choose their
  /// own before using the app.
  mustChangePassword Boolean   @default(false)
  /// When the owner proved they control `email` (password reset link or
  /// Google). An unverified self-registered password is discarded the first
  /// time Google links the account, so nobody can pre-register someone else's
  /// email and keep a way in.
  emailVerifiedAt    DateTime?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  // Relations
  quizzes              Quiz[]
  hostedGameRooms      GameRoom[]        @relation("GameHost")
  gameParticipations   GamePlayer[]
  redemptions          Redemption[]
  pointLedger          PointLedger[]
  uploadedTextbooks    Textbook[]        @relation("TextbookUploader")
  approvedRedemptions  Redemption[]      @relation("RedemptionApprover")
  notifications        Notification[]
  achievements         UserAchievement[]
  createdTournaments   Tournament[]      @relation("TournamentCreator")
  sessions             UserSession[]
  notes                StudentNote[]
  subscriptions        Subscription[]    @relation("StudentSubscriptions")
  createdSubscriptions Subscription[]    @relation("SubscriptionCreator")
  paymentRequests      PaymentRequest[]  @relation("StudentPayments")
  reviewedPayments     PaymentRequest[]  @relation("PaymentReviewer")
  gameContents         GameContent[]     @relation("GameContentCreator")
  teachingAssignments  TeachingAssignment[] @relation("TeacherAssignments")
  savedGraphs          SavedGraph[]      @relation("UserSavedGraphs")
  setActivities        ClassActivity[]   @relation("ActivityTeacher")
  resources            TeacherResource[] @relation("TeacherResources")
  activityTargets      ClassActivityTarget[] @relation("ActivityTargets")
  submissionFiles      SubmissionFile[]      @relation("SubmissionOwner")
  markedSubmissions    ClassActivityTarget[] @relation("ActivityMarker")

  @@map("users")
}

// ─── Saved Graphs (grapher) ─────────────────────────────────
// A student's saved set of graphed functions (with the viewing window), so they
// can revisit or re-open a graph later.
model SavedGraph {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserSavedGraphs", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  expressions String[] // function expressions in x
  view        Json? // { xMin, xMax, yMin, yMax }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("saved_graphs")
}

// ─── Teaching Assignments ───────────────────────────────────
// What a teacher actually teaches. Ethiopian teachers commonly cover several
// (subject, grade) PAIRS — e.g. Science in grade 3 AND Math in grade 4 — so a
// single grade/subject on the user cannot express it. One row per pair.
model TeachingAssignment {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  // free-text (suggested from the Subject list), matching GameContent/Textbook.
  // Subject and grade are always set on secondary rows. A grades 1-8 row may
  // leave either blank: "teaches all of grade 3" or "teaches Mathematics".
  subject   String?
  grade     Int?
  // The one section of that grade this row covers, normalised to upper case
  // (e.g. "A"). A grade can run 20 sections and no teacher takes them all, so
  // the section — not the grade — is the real unit of a secondary class.
  //
  // NULL means "every section", which is what the grades 1-8 rows written
  // before sections existed mean. Postgres does not treat two NULLs as equal,
  // so the unique index below does NOT catch duplicates among those rows;
  // the API checks for them explicitly before inserting.
  section   String?
  createdAt DateTime @default(now())

  activities ClassActivity[]

  @@unique([teacherId, subject, grade, section])
  @@index([teacherId])
  @@map("teaching_assignments")
}

// ─── Teacher resources (saved AI assistant output) ─────────
// A teacher's own library. Separate from ClassActivity on purpose: a lesson
// plan is for the teacher and may never be given to students, while a
// worksheet might be. Saving and assigning are different decisions.
model TeacherResource {
  id       String @id @default(cuid())
  teacherId String
  teacher  User   @relation("TeacherResources", fields: [teacherId], references: [id], onDelete: Cascade)

  /// The AssistantTask it came from (LESSON_PLAN, WORKSHEET, …).
  task  String
  title String
  body  String @db.Text

  // Context it was generated against, kept so the library can be filtered and
  // so "give to my class" can pre-select sensibly. Plain fields rather than
  // relations: the resource must survive a textbook being replaced.
  subject      String?
  grade        Int?
  chapterTitle String?

  /// Every AI result is stored, not only the ones a teacher saves. `kept` is
  /// the author pressing Save: kept on purpose, rather than auto-saved.
  kept     Boolean @default(false)
  /// ASSISTANT (the teaching assistant) or WORKOUT_ACTIVITY (workout problems
  /// written for a class through "Set an activity").
  source   String  @default("ASSISTANT")

  // ── Reuse (lib/teacher-library) — invisible to teachers ────────────────
  // The same bank-first rule as student quizzes: before paying for a new
  // document, serve one another teacher of the same subject and grade already
  // generated for the same request, if this teacher has not had it.
  /// May be served to another teacher. Only originals of curriculum work;
  /// never "Anything else", never a revised document, never a served copy.
  reusable Boolean @default(false) @map("shared")
  /// Exact part of the request: task, chapter(s), and for workout activities
  /// the problem count and difficulty.
  requestKey             String?
  /// The teacher's own instructions, compared by meaning AND topic words.
  instructions           String?
  instructionsEmbedding  Float[]  @default([])
  embeddingModel         String?
  /// Set on a copy served from the bank: the original it came from. Also how
  /// a teacher is never served the same document twice.
  originId               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([grade, reusable])
  @@index([originId])
  @@map("teacher_resources")
}

// ─── Student Notes (floating study scratchpad) ─────────────

model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled")
  content   String?  @db.Text // typed notes
  drawing   String?  @db.Text // PNG data URL of the sketch canvas
  /// What the student was studying when the note was created, e.g.
  /// "Genetics · biology" (a chapter) or "3D Geometry" (a page). Read and
  /// written with raw SQL in the notes API — see route.ts there.
  contextLabel String?
  /// The app path the note was created on, e.g. "/student/tutor".
  contextPath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("student_notes")
}

// ─── Global platform settings (singleton) ───────────────────
// System-wide kill-switches an owner can flip from the admin — e.g. launch with
// AI OFF (no AI bill) and pricing OFF (free for everyone), then turn them on later.
model PlatformSettings {
  id                String   @id @default("singleton")
  aiEnabled         Boolean  @default(true) // master AI switch — off disables ALL AI
  aiTutorEnabled    Boolean  @default(true) // AI tutor chat
  aiQuizGenEnabled  Boolean  @default(true) // AI question / quiz generation
  aiAdaptiveEnabled Boolean  @default(true) // adaptive difficulty
  aiMathToolsEnabled Boolean @default(true) // AI in the graphing calculator & 3D geometry lab
  aiTeacherAssistantEnabled Boolean @default(true) // teachers' AI assistant & AI-written workout problems
  pricingEnabled    Boolean  @default(true) // paid plans & billing — off = free for all
  rewardsEnabled    Boolean  @default(true) // rewards catalogue & redemption — off = hide rewards
  antiCheatEnabled  Boolean  @default(true) // anti-cheat detection & penalties — off = no restrictions
  /// Secondary teachers' monthly AI credits when their school's plan sets no
  /// limit — and ALWAYS while pricing is off, so a free launch is still capped.
  /// Null = no cap. See lib/teacher-ai-allowance for what each credit buys.
  teacherAiDefaultMonthlyCredits Int? @default(300)
  /// AI tutor messages each user may send per day (the day resets at
  /// midnight Addis Ababa time). Null = no daily cap. See lib/tutor-allowance.
  tutorDailyMessageLimit Int? @default(20)
  updatedAt         DateTime @updatedAt

  @@map("platform_settings")
}

/// How many AI tutor replies one user received on one day, for the daily cap
/// (PlatformSettings.tutorDailyMessageLimit). Kept in the database rather than
/// the in-memory rate limiter so a server restart does not hand out a fresh
/// allowance. No FK: the env super admin has no users row.
model TutorDailyUse {
  userId String
  /// Calendar day in Addis Ababa time (UTC+3), stored as a date.
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
  @@map("tutor_daily_uses")
}

// ─── AI Provider Configuration ──────────────────────────────
//
// Model ids and chain order live in the DATABASE, not in code or env, because
// providers retire model ids on their own schedule: meta/llama-3.3-70b-instruct
// started answering 410 Gone mid-2026, and DeepSeek churned through three ids
// (deepseek-chat -> deepseek-v4-flash -> deepseek-flash) in a few months. When
// that happens an admin must be able to point the system at a live model in
// seconds, from the UI, without a code edit or a redeploy.
//
// API KEYS ARE DELIBERATELY NOT HERE. They stay in the environment: a key in a
// database row is a key in every backup, every dump and every admin's browser.
// The UI reports only whether a key is present.
enum AiProviderId {
  GEMINI
  GROQ
  NVIDIA
  OPENROUTER
  OLLAMA
}

model AiProviderConfig {
  id AiProviderId @id

  /// Off means "never try this provider", regardless of priority or keys.
  enabled Boolean @default(true)

  /// Chain order — LOWER RUNS FIRST. Lets an admin demote a provider whose
  /// daily quota is exhausted and promote another, without a deploy.
  priority Int @default(100)

  /// Flagship slot: question generation, chapter detection, the verifier, vision.
  chatModel String?
  /// Cheap/fast slot: Bloom tagging, quality checks, tutor fallback.
  fastModel String?
  /// Embedding slot. Null for providers that serve no embedding model.
  embeddingModel String?

  /// Override the provider's API base (self-hosted Ollama, a proxy, a region).
  /// Null uses the built-in default for that provider.
  baseUrl String?

  /// Last health probe, written by the admin "check" action. Purely
  /// informational — the chain never reads these to make routing decisions,
  /// because a stale probe must not silently disable a working provider.
  lastStatus    String?   // "ok" | "rate_limited" | "bad_model" | "unauthorized" | "no_key" | "payment_required" | "error"
  lastCheckedAt DateTime?
  lastLatencyMs Int?
  lastMessage   String?

  updatedAt DateTime @updatedAt

  @@map("ai_provider_configs")
}

/// Per-task provider chain, edited in Admin -> AI Models. A task with no row
/// uses its built-in default chain (lib/ai-tasks), so a fresh database behaves
/// exactly as before routing existed.
model AiTaskRoute {
  /// Task id from lib/ai-tasks, e.g. "question-generation".
  task String @id

  /// Ordered steps: [{ "provider": "GEMINI", "model": "gemini-3.8-flash" | null }].
  /// A null model means the provider's default model.
  chain Json

  updatedAt DateTime @updatedAt

  @@map("ai_task_routes")
}

// ─── Subjects ───────────────────────────────────────────────

model Subject {
  id        String      @id @default(cuid())
  name      String
  /// Elementary (grades 1-8) and secondary schools teach different subjects,
  /// so each level keeps its own list; the same name may appear in both.
  level     SchoolLevel @default(SECONDARY)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([name, level])
  @@map("subjects")
}

// ─── OTP Codes ────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(cuid())
  // "pwreset:<userId>" — password-reset links (lib/password). `code` holds
  // a sha256 hash, never the token itself.
  key       String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

// ─── User Sessions ────────────────────────────────────────

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  sessionId  String    @unique @default(cuid())
  deviceName String?
  userAgent  String?   @db.Text
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("user_sessions")
}

model School {
  id               String     @id @default(cuid())
  name             String
  region           String
  city             String
  type             SchoolType @default(PUBLIC)
  level            SchoolLevel @default(SECONDARY)
  subscriptionTier String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users         User[]
  textbooks     Textbook[]
  rewards       Reward[]
  rewardBudgets RewardBudget[]
  tournaments   Tournament[]
  gameConfig    GameConfig?
  subscriptions Subscription[]

  @@map("schools")
}

model Textbook {
  id               String           @id @default(cuid())
  title            String
  grade            Int
  subject          String
  language         String           @default("en")
  academicYear     String?
  edition          String?
  publisher        String?
  content          String?          @db.Text
  fileUrl          String
  processingStatus ProcessingStatus @default(PENDING)
  chunkingStatus   ChunkingStatus   @default(PENDING)
  ocrFlaggedPages  Json? // array of { page, confidence } for pages below 80% OCR confidence

  approvalStatus   TextbookApproval @default(APPROVED)
  /// Why the school needs this book (shown to the reviewer).
  requestNote      String?
  /// Reviewer's reason on rejection, or an optional note on approval.
  reviewNote       String?
  reviewedAt       DateTime?
  /// Reviewer's user id — a plain string because the env super admin has no users row.
  reviewedById     String?
  /// Uploaded file awaiting approval, stored under UPLOAD_ROOT/textbooks.
  sourceFile       String?
  sourceFileName   String?
  sourceFileSize   Int?
  /// Why post-approval extraction / chapter detection failed, for a retry.
  processingError  String?
  chapterCount     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  uploadedById String?
  uploadedBy   User?   @relation("TextbookUploader", fields: [uploadedById], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  chapters Chapter[]

  @@index([approvalStatus])
  @@map("textbooks")
}

model Chapter {
  id            String   @id @default(cuid())
  chapterNumber Int
  title         String
  content       String?  @db.Text
  contentHash   String?
  topicTags     String[] @default([])
  bloomLevels   String[] @default([])
  questionCount Int      @default(0)
  ocrConfidence Float?
  /// Set when generation stops finding new material: most of a round's
  /// questions were rejected as repeats of the bank. While it holds (and the
  /// content is unchanged — see saturatedContentHash), quizzes recycle the
  /// bank instead of paying for generation that only produces duplicates.
  saturatedAt          DateTime?
  /// contentHash when saturatedAt was set. Reprocessed content changes the
  /// hash, which lifts saturation: new text means new questions are possible.
  saturatedContentHash String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  questions Question[]
  chunks    ContentChunk[]
  activities ClassActivity[]

  @@unique([textbookId, chapterNumber])
  @@map("chapters")
}

model Question {
  id            String         @id @default(cuid())
  type          QuestionType   @default(MCQ)
  difficulty    Difficulty     @default(MEDIUM)
  status        QuestionStatus @default(PUBLISHED)
  questionText  String
  options       Json           @default("[]")
  correctAnswer String
  explanation   String?
  videoUrl      String?
  bloomLevel    String?
  qualityScore  Float?
  qualityFlags  String[]       @default([])
  usageCount    Int            @default(0)
  avgAccuracy   Float?
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  quizAnswers QuizAnswer[]
  activityUses ClassActivityQuestion[]

  @@map("questions")
}

// ─── Game Content (elementary 1–6; teacher-generated, no textbook) ──────────
// The Phase-0 content foundation for the elementary games. Unlike Question, it
// is NOT tied to a Textbook/Chapter — content is generated from a topic prompt
// or authored by the teacher, so there are no uploads. `payload` is a
// type-discriminated JSON blob whose shape depends on `type`:
//   PAIR     → { "pairs": [{ "left": "…", "right": "…" }, …] }
//   CATEGORY → { "categories": [{ "label": "…", "items": ["…", …] }, …] }
//   MCQ      → { "questions": [{ "question": "…", "options": ["…"], "correctAnswer": "…" }, …] }
model GameContent {
  id        String          @id @default(cuid())
  type      GameContentType
  status    QuestionStatus  @default(PUBLISHED)
  title     String
  subject   String
  grade     Int // elementary band (1–6); classified via lib/grade-band
  language  String          @default("en")
  payload   Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Owner is the teacher who created it. Optional (like Textbook.uploadedBy) so
  // AI-seeded/system content can exist without a human owner, and so the row
  // survives if the account is removed. Role of the owner (TEACHER vs
  // SCHOOL_ADMIN) is settled at onboarding (Phase 1), not here.
  createdById String?
  createdBy   User?   @relation("GameContentCreator", fields: [createdById], references: [id])

  @@index([grade])
  @@index([type])
  @@index([subject])
  @@index([createdById])
  @@map("game_contents")
}

model Quiz {
  id                String    @id @default(cuid())
  mode              QuizMode  @default(SOLO)
  score             Int       @default(0)
  totalPointsEarned Int       @default(0)
  totalQuestions    Int       @default(0)
  correctAnswers    Int       @default(0)
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  isDailyChallenge Boolean @default(false)

  gameRoomId String?
  gameRoom   GameRoom? @relation(fields: [gameRoomId], references: [id])

  // Set when this attempt is a teacher-set activity. SetNull rather than
  // Cascade: removing an activity must never delete a student's answer history.
  activityId String?
  activity   ClassActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  answers QuizAnswer[]

  @@index([studentId])
  @@index([activityId])
  @@map("quizzes")
}

// ─── Teacher-set activities ─────────────────────────────────────────────
// Homework, classwork, a test — anything a secondary teacher sets for one of
// their classes. The questions are PINNED at creation rather than generated
// per student, so the whole class sits the same paper: that is what teachers
// expect, what makes "68% missed Q3" answerable, and what a printable version
// would need.
model ClassActivity {
  id           String         @id @default(cuid())
  kind         ActivityKind   @default(HOMEWORK)
  status       ActivityStatus @default(DRAFT)
  title        String
  instructions String?
  // Advisory only. Late work is accepted and NOT flagged — a student may well
  // have handed the same thing in on paper.
  dueAt        DateTime?

  teacherId String
  teacher   User   @relation("ActivityTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  // The class it was set for. SetNull, never Cascade: a teacher tidying their
  // profile must not delete work students have already done.
  teachingAssignmentId String?
  teachingAssignment   TeachingAssignment? @relation(fields: [teachingAssignmentId], references: [id], onDelete: SetNull)

  // Class identity, denormalised so the activity survives that SetNull and
  // stays scopeable on its own.
  schoolId String
  subject  String
  grade    Int
  section  String

  format ActivityFormat @default(QUESTIONS)

  // DOCUMENT only: whether students must hand something in. When false the
  // activity is read-and-acknowledge, which is what written work done in an
  // exercise book looks like.
  requiresSubmission Boolean @default(false)

  // What the work is marked out of. Null means the teacher gives written
  // feedback without a score — plenty of classwork is not scored.
  maxMarks Int?

  // DOCUMENT activities only: the Markdown the student reads. Null for a
  // QUESTIONS activity, whose content is the pinned questions instead.
  //
  // This is the STUDENT-FACING half and nothing else may be put in it. When a
  // worksheet is generated with worked solutions, the solutions are split off
  // into `answerKey` before anything is stored — a student who receives the
  // answers has not been set work, they have been given a reading exercise.
  body String? @db.Text

  /// Worked solutions and the marking guide. TEACHER-ONLY: no student-facing
  /// route may ever select this column.
  answerKey String? @db.Text

  /// When it actually reached the class. Null while it is still a draft.
  publishedAt DateTime?

  // Provenance of the spec, so the same activity can be set again later.
  //
  // `chapterId` is the PRIMARY chapter and keeps the relation. `chapterIds`
  // holds every chapter the paper drew from, because a revision paper is
  // often a mix across a whole unit. For a single-chapter activity the two
  // agree; older rows have an empty list and fall back to `chapterId`, so
  // nothing has to be backfilled.
  chapterId     String?
  chapter       Chapter?    @relation(fields: [chapterId], references: [id])
  chapterIds    String[]
  textbookId    String?
  difficulty    Difficulty? // null = mixed (MIXED is not an enum value)
  // Zero for a DOCUMENT activity.
  questionCount Int

  questions ClassActivityQuestion[]
  targets   ClassActivityTarget[]
  quizzes   Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, grade, section])
  @@index([teacherId])
  @@map("class_activities")
}

/// The pinned paper: which questions, in which order.
model ClassActivityQuestion {
  id         String        @id @default(cuid())
  activityId String
  activity   ClassActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questionId String
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int

  @@unique([activityId, questionId])
  @@unique([activityId, order])
  @@map("class_activity_questions")
}

/// Who it was set for. Materialised at creation so membership is frozen: a
/// student who joins the section next month does not retroactively owe it.
model ClassActivityTarget {
  id         String        @id @default(cuid())
  activityId String
  activity   ClassActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId  String
  student    User          @relation("ActivityTargets", fields: [studentId], references: [id], onDelete: Cascade)

  // DOCUMENT activities only: when the student marked it done. A QUESTIONS
  // activity derives completion from its Quiz instead, so this stays null
  // there rather than duplicating — and drifting from — that signal.
  completedAt DateTime?

  // ── Submission (DOCUMENT activities that require one) ────────────────
  // Typed rather than uploaded: this project has no file storage at all, and
  // a typed answer works on a connection that a photo upload would not.
  submissionText String?   @db.Text
  submittedAt    DateTime?

  // ── Marking ──────────────────────────────────────────────────────────
  // `marks` is null when the activity carries no maxMarks, or when the
  // teacher has left feedback without a score. `markedAt` is the thing to
  // test for "has this been marked", never `marks`.
  marks      Int?
  feedback   String?   @db.Text
  markedAt   DateTime?
  markedById String?
  markedBy   User?     @relation("ActivityMarker", fields: [markedById], references: [id])

  files SubmissionFile[]

  @@unique([activityId, studentId])
  @@index([studentId])
  @@map("class_activity_targets")
}

/// A file a student handed in against work their teacher set.
///
/// Bytes live on disk, never in this table — only the metadata needed to
/// find, authorise and display them. `storedPath` is relative to the upload
/// root, so moving the volume does not invalidate every row.
///
/// `studentId` and `schoolId` are denormalised deliberately. Authorisation
/// runs on every download, and it must not depend on walking
/// file -> target -> activity -> class to discover who may read the thing.
model SubmissionFile {
  id       String              @id @default(cuid())
  targetId String
  target   ClassActivityTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  /// Who handed it in. The only student who may read it back.
  studentId String
  student   User   @relation("SubmissionOwner", fields: [studentId], references: [id], onDelete: Cascade)

  /// Whose school it belongs to, so an admin of another school can never
  /// reach it even if they guess the id.
  schoolId String

  /// As the student named it. Shown to the teacher, never used to build a
  /// path — a filename from a client is untrusted input.
  originalName String
  /// Relative to the upload root, generated server-side.
  storedPath   String  @unique
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes, so a re-upload of the same file is recognisable.
  checksum     String?

  uploadedAt DateTime  @default(now())
  /// Soft delete: a student replacing a page should not destroy what the
  /// teacher may already have marked against.
  deletedAt  DateTime?

  @@index([targetId])
  @@index([studentId])
  @@map("submission_files")
}

model QuizAnswer {
  id            String  @id @default(cuid())
  studentAnswer String
  isCorrect     Boolean
  timeTakenMs   Int
  pointsEarned  Int     @default(0)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_answers")
}

model GameRoom {
  id         String     @id @default(cuid())
  roomCode   String     @unique
  status     GameStatus @default(WAITING)
  quizConfig Json       @default("{}")
  maxPlayers Int        @default(20)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hostUserId String
  host       User   @relation("GameHost", fields: [hostUserId], references: [id])

  players         GamePlayer[]
  quizzes         Quiz[]
  tournamentRound TournamentRound?

  @@map("game_rooms")
}

model GamePlayer {
  id       String   @id @default(cuid())
  score    Int      @default(0)
  rank     Int?
  joinedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameRoomId String
  gameRoom   GameRoom @relation(fields: [gameRoomId], references: [id], onDelete: Cascade)

  @@unique([userId, gameRoomId])
  @@map("game_players")
}

model Reward {
  id                      String           @id @default(cuid())
  tier                    RewardTier
  name                    String
  description             String?
  pointsCost              Int
  inventoryCount          Int              @default(0)
  imageUrl                String?
  unitCost                Float?
  redemptionWindow        RedemptionWindow @default(ANYTIME)
  windowStartDate         DateTime?
  windowEndDate           DateTime?
  maxRedemptionsPerWindow Int?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id        String           @id @default(cuid())
  status    RedemptionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("RedemptionApprover", fields: [approvedById], references: [id])

  @@map("redemptions")
}

model PointLedger {
  id          String   @id @default(cuid())
  actionType  String
  points      Int
  description String?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  quizId String?

  @@map("point_ledger")
}

model Notification {
  id        String   @id @default(cuid())
  type      String // "achievement", "reward", "battle_invite", "streak", "level_up", "system"
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json? // optional metadata (e.g., achievementId, rewardId)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  code     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("user_achievements")
}

// ─── Reward Budget ──────────────────────────────────────

model RewardBudget {
  id          String   @id @default(cuid())
  name        String
  totalBudget Float
  spentAmount Float    @default(0)
  currency    String   @default("ETB")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@map("reward_budgets")
}

// ─── Tournaments & Game Config ──────────────────────────

model Tournament {
  id               String           @id @default(cuid())
  name             String
  description      String?
  status           TournamentStatus @default(DRAFT)
  rules            Json?
  competitionStart DateTime?
  competitionEnd   DateTime?
  maxPlayers       Int              @default(100)
  subject          String?
  grade            Int?
  difficulty       Difficulty?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdById String
  createdBy   User   @relation("TournamentCreator", fields: [createdById], references: [id])

  rounds TournamentRound[]

  @@map("tournaments")
}

model TournamentRound {
  id          String    @id @default(cuid())
  roundNumber Int
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime  @default(now())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  gameRoomId String?   @unique
  gameRoom   GameRoom? @relation(fields: [gameRoomId], references: [id])

  @@unique([tournamentId, roundNumber])
  @@map("tournament_rounds")
}

model GameConfig {
  id                String     @id @default(cuid())
  maxPlayersPerRoom Int        @default(20)
  timePerQuestion   Int        @default(20)
  defaultDifficulty Difficulty @default(MEDIUM)
  difficultyLocked  Boolean    @default(false)
  minPlayersToStart Int        @default(2)
  updatedAt         DateTime   @updatedAt

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id])

  @@map("game_configs")
}

// ─── Content Chunks (pgvector semantic retrieval) ───────

model ContentChunk {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String                      @db.Text
  tokenCount Int
  bloomLevel String?
  embedding  Unsupported("vector(768)")?

  // Which model produced `embedding`. Vectors from different models are NOT
  // comparable, so this records provenance: it lets a re-embed find rows built
  // by an older model, and lets the admin UI surface a book whose chunks were
  // embedded by the offline fingerprint fallback (which is not semantic at all).
  embeddingModel String?

  createdAt DateTime @default(now())

  @@unique([chapterId, chunkIndex])
  @@index([chapterId])
  @@map("content_chunks")
}

// ─── Pricing & Subscriptions ────────────────────────────

model PricingPlan {
  id              String          @id @default(cuid())
  name            String
  description     String?
  audience        PlanAudience
  pricingModel    PricingModel    @default(FLAT)
  // FLAT → the price; PER_STUDENT → rate per enrolled student; TIERED → null (see tiers)
  price           Float?
  currency        String          @default("ETB")
  billingInterval BillingInterval @default(MONTHLY)
  // STUDENT plans: `price` is the MONTHLY price and these give a percentage
  // discount off the multi-month total when a student picks a longer cycle
  // (0 = no discount, so 3-month = 3×monthly and yearly = 12×monthly). School
  // plans ignore these. 0–100.
  quarterlyDiscountPct Int         @default(0)
  yearlyDiscountPct    Int         @default(0)
  trialDays       Int             @default(0)
  features        String[]        @default([])
  isActive        Boolean         @default(true) // available for assignment
  sortOrder       Int             @default(0)

  // Entitlements — what the plan unlocks. Primarily for STUDENT plans; school
  // students and school plans are always treated as full access regardless.
  // Default true so existing/full plans keep every capability.
  allowAi          Boolean @default(true) // AI tutor, AI video, AI quiz generation
  allowMultiplayer Boolean @default(true) // battle / group games (solo is always allowed)
  allowRewards     Boolean @default(true) // rewards catalogue & redemption
  allowLeaderboard Boolean @default(true) // leaderboard / rankings
  allowMathTools   Boolean @default(true) // graphing calculator & 3D geometry lab
  // Elementary games (card games + tug-of-war). Column exists from Phase 0 so
  // the entitlement dimension is present in the schema; the free-vs-PRO game
  // split is wired through getEntitlements() in Phase 2 when the games ship.
  allowGames       Boolean @default(true) // elementary game modes

  // ── Secondary teachers (SCHOOL plans only; null on student plans) ──
  // Every active secondary teacher adds `pricePerTeacher` to the term price.
  // Null = teachers are not charged, which is how plans priced before this
  // behaved.
  pricePerTeacher       Float?
  // AI CREDITS each secondary teacher may spend per calendar month (the
  // assistant, AI-written activities, merges — weighted by cost, see
  // lib/teacher-ai-allowance). Null = the platform default
  // (PlatformSettings.teacherAiDefaultMonthlyCredits). Library hits that reuse
  // an existing document never count.
  teacherAiMonthlyLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers           PricingTier[]
  subscriptions   Subscription[]
  paymentRequests PaymentRequest[]

  @@index([audience])
  @@map("pricing_plans")
}

model PricingTier {
  id          String   @id @default(cuid())
  minStudents Int
  maxStudents Int? // null = no upper bound
  price       Float
  createdAt   DateTime @default(now())

  planId String
  plan   PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("pricing_tiers")
}

model Subscription {
  id     String      @id @default(cuid())
  planId String
  plan   PricingPlan @relation(fields: [planId], references: [id])

  // Exactly one of schoolId / studentId is set, matching the plan's audience.
  schoolId  String?
  school    School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String?
  student   User?   @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)

  status            SubscriptionStatus @default(ACTIVE)
  // The billing cycle the subscriber actually chose (student plans let them pick
  // monthly / quarterly / yearly). Snapshotted here so renewal & cancel-at-
  // period-end math uses the chosen cycle, not just the plan's base interval.
  billingInterval   BillingInterval    @default(MONTHLY)
  startDate         DateTime           @default(now())
  // For a canceled-at-period-end sub this holds the paid-through date; the sub
  // stays live (access continues) until endDate passes, then it lapses.
  endDate           DateTime?
  // When true, the plan was canceled but access continues until endDate (the
  // end of the already-paid period) instead of ending immediately.
  cancelAtPeriodEnd Boolean            @default(false)

  // Snapshot of the computed price at assignment time (audit trail).
  amount               Float?
  currency             String  @default("ETB")
  studentCountSnapshot Int? // school subs: enrolled students when priced
  teacherCountSnapshot Int? // school subs: active secondary teachers when priced
  notes                String?

  createdById String?
  createdBy   User?   @relation("SubscriptionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([planId])
  @@map("subscriptions")
}

// Admin-configurable payee accounts shown to students on the payment step
// (e.g. Telebirr / CBE / BOA). The student pays here off-platform, then submits
// proof (transaction ref + receipt) which an admin reviews.
model PaymentAccount {
  id            String   @id @default(cuid())
  method        String // display label, e.g. "Telebirr", "CBE", "BOA", "Safaricom"
  accountName   String // account holder name
  accountNumber String // phone / account number
  instructions  String? // optional note shown to the student
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_accounts")
}

// A manual payment submitted by an INDEPENDENT student to activate a paid plan.
// It sits in PENDING until an admin approves (which creates the subscription) or
// rejects. Amount/interval are snapshotted so approval doesn't depend on the plan
// being unchanged in the meantime.
model PaymentRequest {
  id              String          @id @default(cuid())
  studentId       String
  student         User            @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  planId          String
  plan            PricingPlan     @relation(fields: [planId], references: [id])
  billingInterval BillingInterval @default(MONTHLY)
  amount          Float
  currency        String          @default("ETB")

  // Proof of payment.
  methodLabel   String // which method the student says they paid with
  transactionRef String
  receiptData   String  @db.Text // base64 data URL of the receipt image
  receiptName   String?
  receiptType   String?

  status       PaymentRequestStatus @default(PENDING)
  adminNote    String? // rejection reason / note
  reviewedById String?
  reviewedBy   User?                @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  // The subscription created when this payment is approved.
  subscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("payment_requests")
}

/// One AI model call's token usage and list-price cost.
///
/// Written on every provider call so AI spend is durable and attributable per
/// FEATURE — the vendor console only breaks spend down by model, and several
/// features share the same Gemini models. Unlike the in-memory totals it
/// replaced, these rows survive restarts and are shared across every route and
/// server instance (the reason a book upload's usage never reached the admin
/// page: separate route bundles hold separate in-memory maps).
model UsageEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  feature  String // e.g. "question-generation", "chapter-detection", "bloom-tagging"
  provider String // "gemini" | "groq" | "nvidia" | "ollama"
  model    String // exact model id the provider reported

  // Who the call was made FOR, so spend is attributable to a student and a
  // school rather than only to a feature. Both null for content-side work that
  // no single student triggered (question generation, chapter detection): that
  // cost is one-time per textbook and amortised across everyone who uses it.
  // Denormalised on purpose — the school is copied from the student at write
  // time so moving a student later never rewrites billing history, and neither
  // FK cascades, so deleting a user keeps the spend they caused on the books.
  studentId String?
  schoolId  String?
  // Set for calls a secondary teacher made (assistant, AI activities, merges),
  // so teacher cost is visible per teacher and not only as school overhead.
  teacherId String?

  promptTokens   Int
  outputTokens   Int
  thinkingTokens Int
  totalTokens    Int

  // List-price USD cost of this call, computed at write time so a later price
  // change never rewrites history. Null when the model had no price entry.
  costUsd  Float?
  unpriced Boolean @default(false)

  @@index([createdAt])
  @@index([feature])
  @@index([studentId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("usage_events")
}

/// One AI generation a secondary teacher ran; its `credits` are what their
/// monthly allowance (`PricingPlan.teacherAiMonthlyLimit`) sums. Separate from
/// UsageEvent because one generation makes many provider calls (embeddings,
/// retries, per-chapter question batches); this is one row per thing the
/// teacher asked for. Written only when the AI actually produced it.
model TeacherAiUse {
  id        String   @id @default(cuid())
  teacherId String
  schoolId  String
  kind      String // "assistant" | "workout" | "questions" | "merge"
  /// Weighted by what the generation costs (lib/teacher-ai-allowance) — a
  /// 25-question paper is not the same spend as one assistant reply.
  credits   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([teacherId, createdAt])
  @@map("teacher_ai_uses")
}
