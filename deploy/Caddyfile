# HTTPS for Abugida. Caddy gets and renews the certificate automatically once
# DNS for $DOMAIN points at this server and ports 80/443 are open.
# WebSockets (Socket.io battles) pass through reverse_proxy with no extra setup.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3001
}

# www and the old subdomain both forward to the main address, so old links and
# bookmarks keep working. Each needs a DNS record pointing at this server.
www.{$DOMAIN}, abugida.aderasend.com {
	redir https://{$DOMAIN}{uri} permanent
}
