# Database (Neon/Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/ethiolearn?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# AfricasTalking SMS (production only)
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=EthioLearn

# AI/LLM (for question generation — Google Gemini)
GEMINI_API_KEY=""
# Optional: override the Gemini models. Both have sensible defaults; set them
# only to pin a version or to move off a model that returns "limit: 0" quota
# errors. See https://ai.google.dev/gemini-api/docs/models
#
# Flagship tier — question generation, chapter detection, the answer verifier,
# video scripts and the vision tasks. Default: gemini-3.8-flash
GEMINI_MODEL=""
# Fast tier — Bloom tagging, post-generation quality checks, tutor fallback.
# Default: gemini-3.1-flash-lite
GEMINI_FAST_MODEL=""
