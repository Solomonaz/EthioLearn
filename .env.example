# ══════════════════════════════════════════════════════════════════════════
# Abugida environment. Copy to .env and fill in. Never commit .env.
# ══════════════════════════════════════════════════════════════════════════

# ── Docker deployment (docker-compose.yml, deploy/DEPLOY.md) ─────────────────
# The site's address, without https:// (Caddy gets its certificate for this).
DOMAIN="abugida.aderasend.com"
# Database password. Long and random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# docker-compose builds DATABASE_URL from it, so DATABASE_URL below is only
# for local development.
POSTGRES_PASSWORD=""
# Off-server backup target for deploy/backup.sh (Hetzner Storage Box), e.g.
#   u123456@u123456.your-storagebox.de:abugida-backups
BACKUP_REMOTE=""
BACKUP_REMOTE_PORT="23"

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres with the pgvector extension (CREATE EXTENSION vector; before db push)
DATABASE_URL="postgresql://postgres:password@localhost:5433/ethiolearn"
# Public URL of the site. Also used for Socket.io's allowed origin and for the
# links in password-reset emails. https:// in production.
NEXTAUTH_URL="http://localhost:3001"
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
PORT=3001
# Where uploads (textbooks, student submissions) are stored. In production,
# point this at a persistent volume.
UPLOAD_ROOT=""

# ── Break-glass super admin (/admin_ethiolearn) ─────────────────────────────
# Signs in with email + password; no database row. In production the
# password must be at least 16 characters or sign-in is refused.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# ── Sign-in providers ────────────────────────────────────────────────────────
# Google: authorised redirect URI = <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="true"
# Telegram: set the bot's domain with @BotFather /setdomain to your site.
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_ID=""
# Facebook (optional)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
NEXT_PUBLIC_FACEBOOK_ENABLED="false"

# ── Email (password-reset links) ─────────────────────────────────────────────
# Both required in production for "Forgot password" — without them the form says the
# feature is unavailable. The sending domain must be verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Abugida <noreply@yourdomain.com>"

# ── AI providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# Optional model overrides. Flagship tier (question generation, verifier,
# vision) and fast tier (tagging, quality checks, tutor fallback).
GEMINI_MODEL=""
GEMINI_FAST_MODEL=""
GEMINI_THINKING_BUDGET=""
GROQ_API_KEY=""
GROQ_MODEL=""
NVIDIA_API_KEY=""
NVIDIA_MODEL=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=""
OPENROUTER_REASONING=""
# Local Ollama (development only)
OLLAMA_ENABLED="false"
OLLAMA_BASE_URL=""
# "gemini" (default) or "ollama"
EMBEDDING_PROVIDER=""

# ── Usage reporting (Admin → AI usage) ───────────────────────────────────────
USAGE_CURRENCY=""
USAGE_FX_PER_USD=""

# ── Safety switches (leave false in production) ──────────────────────────────
# Allow dropping and rebuilding the embedding column when its size changes
# (destroys every stored embedding).
ALLOW_VECTOR_COLUMN_REBUILD="false"
# Allow non-semantic fallback vectors when no embedding provider works.
ALLOW_FINGERPRINT_EMBEDDINGS="false"
